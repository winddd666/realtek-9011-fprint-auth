# Maintainer: xzq <xiazq123666@gmail.com>

pkgname=libfprint-realtek-9011
_pkgname=libfprint
pkgver=1.94.100
pkgrel=3
pkgdesc="Library for fingerprint readers (with Realtek 3274:9011 Match-on-Chip support)"
url="https://fprint.freedesktop.org/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  glib2
  glibc
  libgcc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
provides=(
  libfprint
  libfprint-2.so
)
conflicts=(libfprint)
groups=(fprint)

# Upstream master commit including realtek SSM error UAF fix (26d3877)
_commit=6f9479c3d55f847c1b3769f28ceb99227f9858cf
source=(
  "git+https://gitlab.freedesktop.org/libfprint/libfprint.git#commit=${_commit}"
  "0001-realtek-add-3274-9011-support.patch"
)
sha256sums=(
  'SKIP'
  '13a06f818d8ee8718115f8e230caa768e74b2c0bb42f5bdff51f1a6df62c8adb'
)

prepare() {
  cd "$_pkgname"
  git apply "$srcdir/0001-realtek-add-3274-9011-support.patch"
}

build() {
  local meson_options=(
    -D drivers=all
    -D installed-tests=false
  )

  arch-meson "$_pkgname" build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build \
    udev-hwdb \
    realtek \
    realtek-5816 \
    realtek-9011 \
    realtek-storage-errors \
    fpi-assembling \
    fpi-ssm \
    fpi-device \
    --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}

