+{
+  if (fpi_device_get_driver_data (FP_DEVICE (self)) & FP_RTK_QUIRK_CAPTURE_PARAMS)
+    {
+      cmd->param[0] = self->fp_purpose;
+      cmd->param[1] = rtk_capture_mode (self);
+    }
+  else
+    {
+      cmd->param[0] = 0;
+      cmd->param[1] = 0;
+    }
+}
