+static guint8
+rtk_capture_mode (FpiDeviceRealtek *self)
+{
+  if (!(fpi_device_get_driver_data (FP_DEVICE (self)) & FP_RTK_QUIRK_CAPTURE_PARAMS))
+    return 0;
+
+  return self->fp_purpose == FP_RTK_PURPOSE_ENROLL ? 2 : 1;
+}
